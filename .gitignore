# Cache written by the old local site (refetched from DSE on start).
local/data/
node_modules/
.next/
.env*
.claude/settings.local.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Google service-account keys live in ~/.config/dse, never in the repo.
*service-account*.json
dse-trader-*.json
*google-key*.json
# Expo template agent settings, not project code.
app/.claude/

# Release APKs — large binaries, not committed.
apk/

# Google OAuth client file: values live in web/.env.local; keep the file outside the repo.
client_secret_*.json

# Account recovery codes: kept outside the repo.
vercel-recovery-codes-*.txt
